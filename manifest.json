{
  "manifest_version": 3,
  "name": "X Grok Sidebar — MIST-grade",
  "version": "0.5.0",
  "description": "SSO-first Grok companion on X: pin tweets, friends, gated post-on-behalf. xAI key optional (cloud). Sovereign mist/local/os fallbacks.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Grok Sidebar settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "activeTab", "identity"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://api.x.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://huggingface.co/*",
    "https://cdn.jsdelivr.net/*",
    "https://*.hf.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "panel.css",
        "crypto.js",
        "router.mjs",
        "mist.js",
        "os.js",
        "localmodel.js",
        "lib/*"
      ],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
