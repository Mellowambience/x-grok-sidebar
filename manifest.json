{
  "manifest_version": 3,
  "name": "X Grok Sidebar — MIST-grade",
  "version": "0.4.0",
  "description": "Persistent Grok companion on X's right rail. Pin tweets, chat with Grok/MIST/local, gated post-on-behalf, sovereign fallbacks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Grok Sidebar settings"
  },
  "permissions": ["storage", "activeTab", "identity", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*",
    "https://api.x.ai/*",
    "https://api.twitter.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://huggingface.co/*",
    "https://cdn.jsdelivr.net/*",
    "https://*.hf.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "panel.css",
        "crypto.js",
        "router.mjs",
        "mist.js",
        "os.js",
        "localmodel.js",
        "lib/*"
      ],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
